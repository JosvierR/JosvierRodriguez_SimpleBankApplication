# Documentation only. Spring Boot does not load this file.
# Copy the names into your shell. Never commit a real connection string.

MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority&appName=SimpleBank
MONGODB_DATABASE=simple_bank
JWT_SECRET=<base64-encoded-256-bit-secret>
JWT_EXPIRATION_MS=3600000

# Leave disabled. Enable once to promote an existing login when no enabled ADMIN exists, then set it back to false.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=

# Optional Docker host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Staging and production use separate profiles, databases, and JWT secrets.
# SPRING_PROFILES_ACTIVE=staging
# MONGODB_DATABASE=simple_bank_staging
# CORS_ALLOWED_ORIGINS=https://simple-bank-staging.vercel.app
# DEMO_SEED_ENABLED=false

# Public frontend value. It is not a secret. Local development leaves it unset and uses /api.
# VITE_API_BASE_URL=https://<backend-host>/api
# VITE_APP_ENV=staging
