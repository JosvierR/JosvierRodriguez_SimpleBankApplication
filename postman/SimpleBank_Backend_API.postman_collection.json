{
  "info": {
    "name": "Simple Bank Backend API",
    "description": "Phase 2 of the Simple Bank application. MongoDB Atlas API. Run the folders from top to bottom. Create User generates a new email so a previous run does not collide.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "customer1Id",
      "value": ""
    },
    {
      "key": "customer2Id",
      "value": ""
    },
    {
      "key": "customer3Id",
      "value": ""
    },
    {
      "key": "customer1Email",
      "value": ""
    },
    {
      "key": "customer1UpdatedEmail",
      "value": ""
    },
    {
      "key": "customer1CreatedAt",
      "value": ""
    },
    {
      "key": "customer2Email",
      "value": ""
    },
    {
      "key": "customer2AccountId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'josvier+' + Date.now() + '@example.com';",
                  "pm.collectionVariables.set('email', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('userId', String(body.id));",
                  "pm.test('User id was returned', function () {",
                  "    pm.expect(body.id).to.be.a('string');",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('email'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Josvier Rodriguez\",\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns the created user', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('userId'));",
                  "    pm.expect(body.name).to.eql('Josvier Rodriguez');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accountId', body.accountId);",
                  "pm.test('Account opens with a zero balance', function () {",
                  "    pm.expect(Number(body.balance)).to.eql(0);",
                  "    pm.expect(body.accountType).to.eql('SAVINGS');",
                  "    pm.expect(body.userName).to.eql('Josvier Rodriguez');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"accountType\": \"SAVINGS\"\n}"
            },
            "url": "{{baseUrl}}/accounts"
          }
        },
        {
          "name": "Get Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          }
        },
        {
          "name": "Deposit 500",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Balance is 500', function () {",
                  "    pm.expect(Number(pm.response.json().balance)).to.eql(500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/deposit"
          }
        },
        {
          "name": "Deposit 250",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Balance is 750', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(Number(pm.response.json().balance)).to.eql(750);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 250\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/deposit"
          }
        },
        {
          "name": "Withdraw 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Balance is 550', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(Number(pm.response.json().balance)).to.eql(550);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 200.00\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/withdraw"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get Transaction History",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('History is deposit 500, deposit 250, withdraw 200', function () {",
                  "    const history = pm.response.json();",
                  "    pm.expect(history).to.have.lengthOf(3);",
                  "    pm.expect(history[0].type).to.eql('DEPOSIT');",
                  "    pm.expect(Number(history[0].amount)).to.eql(500);",
                  "    pm.expect(history[1].type).to.eql('DEPOSIT');",
                  "    pm.expect(Number(history[1].amount)).to.eql(250);",
                  "    pm.expect(history[2].type).to.eql('WITHDRAW');",
                  "    pm.expect(Number(history[2].amount)).to.eql(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        }
      ]
    },
    {
      "name": "Validation & Error Cases",
      "item": [
        {
          "name": "Withdraw 1000 Insufficient Funds",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
