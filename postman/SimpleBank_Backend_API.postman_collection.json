          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/withdraw"
          }
        },
        {
          "name": "Get Account After Failed Withdrawal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Balance is still 550', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(Number(pm.response.json().balance)).to.eql(550);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          }
        },
        {
          "name": "History Excludes Failed Withdrawal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Failed withdrawal was not recorded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const history = pm.response.json();",
                  "    pm.expect(history).to.have.lengthOf(3);",
                  "    pm.expect(history.some(tx => Number(tx.amount) === 1000)).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
