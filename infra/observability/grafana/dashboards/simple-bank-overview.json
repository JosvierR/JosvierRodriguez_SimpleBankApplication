{
  "uid": "simple-bank-overview",
  "title": "Simple Bank Overview",
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API health",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"simple-bank-api\"}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Container CPU and memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        { "expr": "process_cpu_usage", "refId": "A", "legendFormat": "cpu" },
        { "expr": "jvm_memory_used_bytes", "refId": "B", "legendFormat": "memory" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Backend uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "targets": [{ "expr": "process_uptime_seconds", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs by container",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [{ "expr": "{container=~\".+\"}", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Error log stream",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [{ "expr": "{container=~\".+\"} |~ \"(?i)error|exception\"", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Mongo container status",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "count_over_time({container=\"simple-bank-mongo\"}[5m])", "refId": "A" }]
    }
  ]
}
