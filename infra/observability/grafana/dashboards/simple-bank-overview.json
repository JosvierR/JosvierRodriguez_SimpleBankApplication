{
  "uid": "simple-bank-overview",
  "title": "Simple Bank Overview",
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API UP",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"simple-bank-api\"}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Backend uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "process_uptime_seconds{job=\"simple-bank-api\"}", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JVM memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{job=\"simple-bank-api\"})", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Process CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "process_cpu_usage{job=\"simple-bank-api\"}", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Backend logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [{ "expr": "{container=~\".+\"}", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Error and exception logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "{container=~\".+\"} |~ \"(?i)error|exception\"", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Mongo container activity",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "count_over_time({container=\"simple-bank-mongo\"}[15m])", "refId": "A" }]
    }
  ]
}
